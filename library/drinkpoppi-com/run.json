   "check": "vision_no",
   "args": {
    "question": "Are any competitor logos visible in this frame?"
   },
   "why": "Brand card never list includes competitor logos; avoids brand confusion and legal risk."
  },
  {
   "id": "vision-no-health-001",
   "check": "vision_no",
   "args": {
    "question": "Is any health claim visible in this frame?"
   },
