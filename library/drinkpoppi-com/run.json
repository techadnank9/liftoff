  {
   "id": "vision-no-calorie-001",
   "check": "vision_no",
   "args": {
    "question": "Is calorie count or sugar content visible in this frame?"
   },
   "why": "Brand card never list includes calorie count and sugar content; avoids contradicting playful tone with nutritional focus."
  }
