  "text_hex": "#141414",
  "tone": [
   "playful",
   "nostalgic",
   "bold"
  ],
  "logo_path": "/Users/adnan/Documents/liftoff/assets/drinkpoppi-com/logo.png",
  "can_path": "/Users/adnan/Documents/liftoff/assets/drinkpoppi-com/can.png",
  "must_haves": [
   "brand name visible",
   "vertical 9:16",
   "under 15 seconds"
  ],
  "never": [
   "calorie count",
   "competitor logos",
   "health claims",
   "sugar content"
  ]
 },
 "phase": "done",
 "flight_plan": [
  {
   "id": "dur-1",
   "check": "duration_between",
   "args": {
    "min_s": 6.0,
    "max_s": 15.0
   },
   "why": "Mission requires under 15 seconds; vertical feed norm is 6-15s per research on short-form ads."
  },
  {
   "id": "ar-1",
   "check": "aspect_ratio",
   "args": {
    "ratio": "9:16"
   },
   "why": "Mission specifies vertical feeds; brand card requires vertical 9:16."
  },
  {
   "id": "logo-1",
   "check": "logo_seconds_at_least",
   "args": {
    "min_s": 3.0
   },
   "why": "Research sources cite category norm: brand visible 3s+ in short-form video."
  },
  {
   "id": "pal-1",
   "check": "palette_within",
   "args": {
    "max_distance": 60.0
   },
   "why": "Brand card provides primary (#FFF200) and secondary (#EC008C) hex; background must stay within 60 RGB distance to remain on-brand."
  },
  {
   "id": "tc-1",
   "check": "text_contrast_at_least",
   "args": {
    "min_ratio": 4.5
   },
   "why": "WCAG AA standard for text readability; brand card text_hex is #141414, requiring sufficient contrast against backgrounds."
  },
  {
   "id": "vis-hook",
   "check": "vision_yes",
   "args": {
    "question": "Is there a readable hook (text or visual cue) in the first-second frame?"
   },
   "why": "Research: 'The First Five Seconds' emphasizes immediate hook to prevent skip; mission calls for playful tone needing quick engagement."
  },
  {
   "id": "vis-end",
   "check": "vision_yes",
   "args": {
    "question": "Is the brand name 'poppi' shown as an end card in the last-second frame?"
   },
   "why": "Brand card requires 'brand name visible'; end-card ensures recall; research shows last-frame branding boosts lift."
  },
  {
   "id": "vis-no-comp",
   "check": "vision_no",
   "args": {
    "question": "Are any competitor logos visible in this frame?"
   },
   "why": "Brand card 'never' list includes competitor logos; must be absent in all frames."
  },
  {
   "id": "vis-no-health",
   "check": "vision_no",
   "args": {
    "question": "Is a health claim visible in this frame?"
   },
   "why": "Brand card 'never' list includes health claims; mission is for sparkling soda, not functional beverage; avoids implied benefits."
  },
  {
   "id": "vis-no-cal",
   "check": "vision_no",
   "args": {
    "question": "Is calorie count or sugar content visible in this frame?"
   },
   "why": "Brand card 'never' list includes calorie count and sugar content; must not appear to avoid nutritional claims."
  }
 ],
