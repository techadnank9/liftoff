  {
   "id": "dur-1",
   "check": "duration_between",
   "args": {
    "min_s": 6.0,
    "max_s": 15.0
   },
   "why": "Mission requires under 15 seconds; vertical feed norm is 6-15s"
  },
  {
   "id": "ar-1",
   "check": "aspect_ratio",
   "args": {
    "ratio": "9:16"
   },
   "why": "Mission specifies vertical feeds; brand card requires vertical 9:16"
  },
  {
   "id": "logo-1",
   "check": "logo_seconds_at_least",
   "args": {
    "min_s": 3.0
   },
   "why": "Category norm: brand visible 3s+ in short-form (research source)"
  },
  {
   "id": "palette-1",
   "check": "palette_within",
   "args": {
    "max_distance": 60.0
   },
   "why": "Brand card provides primary_hex #D85A30 and secondary_hex #26215C for background conformity"
  },
  {
   "id": "contrast-1",
   "check": "text_contrast_at_least",
   "args": {
    "min_ratio": 4.5
   },
   "why": "WCAG AA standard for text readability; brand card text_hex #FFFFFF needs sufficient contrast"
  },
  {
   "id": "vision-hook",
   "check": "vision_yes",
   "args": {
    "question": "Does the first-second frame contain a readable hook?"
   },
   "why": "Research: First five seconds critical for unskippable ads (Think with Google source)"
  },
  {
   "id": "vision-endcard",
   "check": "vision_yes",
   "args": {
    "question": "Does the last-second frame show the brand name as an end card?"
   },
   "why": "Brand card must_haves: brand name visible; recall boost from end-frame branding"
  },
  {
   "id": "vision-no-competitor",
   "check": "vision_no",
   "args": {
    "question": "Are any competitor logos visible in this frame?"
   },
   "why": "Brand card never list includes competitor logos"
  },
  {
   "id": "vision-no-health",
   "check": "vision_no",
   "args": {
    "question": "Is any health or medical claim visible in this frame?"
   },
   "why": "Brand card never list includes health claims; mission implies no medical/legal claims"
  }
 ],
